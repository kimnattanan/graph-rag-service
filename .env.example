# Copy to .env before `docker compose up`.
# Values below are for local development. Change every secret before any shared environment.

# Listen port inside each app container. Host ports are mapped in docker-compose.yml.
PORT=3000

# Optional. Defaults are fine for local Docker.
# LOCAL_ENV=false
# HTTP_ALLOWED_ORIGINS=http://localhost:3000
# GRPC_NO_TLS=true

# Shared by every service. HS256 secret for access tokens.
JWT_SECRET=change-me
# Access token lifetime in seconds. Default 86400 (24h).
JWT_TTL_SECONDS=86400

# Seeded once on user-service startup when all three are set.
# The account receives role admin (knowledge:write and conversation:ask).
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# user-postgres. Compose overrides the host to user-postgres.
USER_POSTGRES_HOST=localhost
USER_POSTGRES_PORT=5432
USER_POSTGRES_USER=postgres
USER_POSTGRES_PASSWORD=postgres
USER_POSTGRES_DB=users
USER_POSTGRES_SSLMODE=disable

# conversation-postgres. Compose overrides the host to conversation-postgres.
# Host port 5433 keeps this database off the user database port.
CONVERSATION_POSTGRES_HOST=localhost
CONVERSATION_POSTGRES_PORT=5433
CONVERSATION_POSTGRES_USER=postgres
CONVERSATION_POSTGRES_PASSWORD=postgres
CONVERSATION_POSTGRES_DB=conversation
CONVERSATION_POSTGRES_SSLMODE=disable

# Memgraph. Inside Compose the host name is the memgraph service.
# These credentials must match the Memgraph container.
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=memgraph

# Leave worker count at 0 in this file.
# docker-compose sets KNOWLEDGE_WORKER_COUNT=1 on knowledge-http only,
# so indexing does not also run inside knowledge-grpc.
# Interval is seconds between indexing, entity embedding, and orphan sweeps.
KNOWLEDGE_WORKER_COUNT=0
KNOWLEDGE_WORKER_INTERVAL=20

# Address conversation uses to call knowledge Retrieve.
# Inside Compose this is the knowledge-grpc service. From the host it is localhost:3010.
KNOWLEDGE_GRPC_ADDRESS=knowledge-grpc:3000

# OpenAI-compatible chat API used to extract entities and answer questions.
# Example below is Ollama on the host, reached from containers via host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# OpenAI-compatible embeddings API. The same model embeds chunks, entities, and queries.
# VECTOR_EMBEDDING_DIMENSION must match the model. It is also the Memgraph vector index
# dimension, chosen once at startup. Changing it later requires a new index and a reindex.
VECTOR_EMBEDDING_URL=http://host.docker.internal:11434/v1/embeddings
VECTOR_EMBEDDING_API_KEY=ollama
VECTOR_EMBEDDING_MODEL=all-minilm
VECTOR_EMBEDDING_DIMENSION=384
